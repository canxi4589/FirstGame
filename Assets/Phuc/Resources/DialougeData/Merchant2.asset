  m_Script: {fileID: 11500000, guid: e067866778c7d674684e5db79f8171b4, type: 3}
  m_Name: Merchant2
  m_EditorClassIdentifier: 
  dialogues:
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "C\xF3 v\u1EBB ng\xE0i v\u1EEBa t\u1EEB V\xF9ng K\xED \u1EE8c v\u1EC1 nh\u1EC9.
      G\u1EB7p \u0111\u01B0\u1EE3c ng\xE0i nh\u01B0 th\u1EBF n\xE0y th\xEC t\xF4i
      ngh\u0129 l\xE0 Tay Ph\u1EA3i \u0111\xE3 b\u1ECB \u0111\xE1nh b\u1EA1i r\u1ED3i."
  - speaker: Lilia
    text: "R\u1EA5t kh\xF3 nh\u1EB1n nh\u01B0ng ta \u0111\xE3 th\xE0nh c\xF4ng, c\u1EA3m
      \u01A1n v\xEC v\u0169 khi c\u1EE7a \xF4ng."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "\u0110\xF3 l\xE0 vinh h\u1EA1nh c\u1EE7a t\xF4i, nh\u01B0 nh\u1EEFng l\u1EA7n
      tr\u01B0\u1EDBc. "
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "... Ti\u1EBFp theo s\u1EBD l\xE0 Sa M\u1EA1c Kh\xF4ng N\u01B0\u1EDBc,
      m\u1ED9t n\u01A1i n\xF3ng t\u1EDBi m\u1EE9c m\xE0 ch\u01B0a c\xF3 sinh v\u1EADt
      n\xE0o t\u1ED3n t\u1EA1i qu\xE1 m\u1ED9t ng\xE0y."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "V\xEC th\u1EBF, h\xE3y m\u1EB7c chi\u1EBFc kh\u0103n n\xE0y, n\xF3 \u0111\u01B0\u1EE3c
      tr\u1ED9n v\u1EDBi ph\xE9p thu\u1EADt c\xE2n b\u1EB1ng nhi\u1EC7t \u0111\u1ED9,
      s\u1EBD gi\xFAp ng\xE0i lu\xF4n gi\u1EEF \u0111\u01B0\u1EE3c nhi\u1EC7t \u0111\u1ED9
      th\xEDch h\u1EE3p."
  - speaker: Lilia
    text: "Ta c\u1EA3m \u01A1n."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Ch\xE2n Tr\xE1i s\u1EBD l\xE0 m\u1ED9t qu\xE1i v\u1EADt kh\xF3 nh\u1EB1n,
      c\xF4ng ch\xFAa h\xE3y c\u1EA9n th\u1EADn, t\xF4i s\u1EBD \u0111\u1EE3i ng\xE0i
      xu\u1EA5t hi\u1EC7n l\u1EA7n n\u1EEFa."
  - speaker: Lilia
    text: "Ch\u1EAFc ch\u1EAFn r\u1ED3i, ta s\u1EBD kh\xF4ng thua \u0111\xE2u"
