  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e067866778c7d674684e5db79f8171b4, type: 3}
  m_Name: Merchant3
  m_EditorClassIdentifier: 
  dialogues:
  - speaker: Lilia
    text: "K\u1EBB Bu\xF4n B\xE1n, ta tr\u1EDF l\u1EA1i r\u1ED3i \u0111\xE2y"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Th\u1EADt b\u1EA5t ng\u1EDD khi ng\xE0i l\u1EA1i g\u1ECDi t\xF4i tr\u01B0\u1EDBc
      ti\xEAn \u0111\xF3, c\xF3 v\u1EBB ng\xE0i \u0111\xE3 t\u1EF1 tin h\u01A1n r\u1EA5t
      nhi\u1EC1u r\u1ED3i."
  - speaker: Lilia
    text: "Ta v\u1EABn kh\xF4ng qu\xEAn m\u1EE5c ti\xEAu ban \u0111\u1EA7u, tuy v\u1EABn
      c\xF2n nhi\u1EC1u lo l\u1EAFng, nh\u01B0ng ch\u1EAFc ch\u1EAFn ta s\u1EBD c\u1EE9u
      \u0111\u01B0\u1EE3c ch\xE0ng \u1EA5y"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "T\xF4i th\xEDch nghe \u0111i\u1EC1u \u0111\xF3. "
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "\u0110\u1EA1i s\u1EA3nh \u0110\u1EA1nh S\u1EA3i l\xE0 khu v\u1EF1c ngay
      tr\u01B0\u1EDBc L\xE2u \u0110\xE0i T\xECnh \xC1i c\u1EE7a Ma Z\u01B0\u01A1ng,
      \u0111\xF3 s\u1EBD l\xE0 n\u01A1i ng\xE0i \u0111\u1ED1i \u0111\u1EA7u v\u1EDBi
      t\xEAn B\u1EC7 H\u1EA1 cu\u1ED1i c\xF9ng, Ch\xE2n Ph\u1EA3i"
  - speaker: "K\u1EBB Bu\xF4n b\xE1n"
    text: "T\xEAn \u0111\xF3 s\u1EBD s\u1EED d\u1EE5ng s\u1ED1 l\u01B0\u1EE3ng \u0111\u1EC3
      \xE1p \u0111\u1EA3o ng\xE0i, h\xE3y c\u1EA9n th\u1EADn nh\xE9, nh\u1EEFng v\u0169
      kh\xED t\u1EA5n c\xF4ng t\u1EA7m xa v\xE0 l\u1EDBn s\u1EBD l\xE0 m\u1ED9t l\u1EE3i
      th\u1EBF, v\xE0 ch\u1EAFc ch\u1EAFn t\xF4i \u0111\xE3 chu\u1EA9n b\u1ECB cho
      ng\xE0i v\xE0i m\xF3n."
  - speaker: Lilia
    text: "Ta ch\xE2n th\xE0nh c\u1EA3m \u01A1n"
