  m_Script: {fileID: 11500000, guid: e067866778c7d674684e5db79f8171b4, type: 3}
  m_Name: Merchant1
  m_EditorClassIdentifier: 
  dialogues:
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Xin ch\xE0o C\xF4ng ch\xFAa Lilia, ng\u1ECDn gi\xF3 n\xE0o \u0111\xE3
      mang n\xE0ng \u0111\u1EBFn ch\u1ED1n \u0111\xF4ng ng\u01B0\u1EDDi n\xE0y?"
  - speaker: Lilia
    text: ...
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Ng\xE0i Lilia, t\xF4i bi\u1EBFt \u0111\xF3 l\xE0 ng\xE0i sau l\u1EDBp
      \xE1o cho\xE0ng \u0111\xF3, t\xF4i ch\u1EC9 mu\u1ED1n ch\xE0o h\u1ECFi th\xF4i..."
  - speaker: Lilia
    text: ...
  - speaker: Lilia
    text: "Sao \xF4ng bi\u1EBFt \u0111\u01B0\u1EE3c... V\xE0... \u1EDCm... \xD4ng
      l\xE0...."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Xin ng\xE0i c\u1EE9 g\u1ECDi t\xF4i l\xE0 K\u1EBB Bu\xF4n B\xE1n, t\xF4i
      b\xE1n d\u1EE5ng c\u1EE5 \u1EDF \u0111\xE2y c\u0169ng \u0111\xE3 l\xE2u"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "n\u01A1i ch\u1ED1n ngh\xE8o kh\xF3 n\xE0y th\xEC kh\xF4ng th\u1EC3 g\u1EB7p
      \u0111\u01B0\u1EE3c c\xF4ng ch\xFAa \u0111\xE2y, n\xEAn t\xF4i th\u1EADt s\u1EF1
      b\u1EA5t ng\u1EDD khi b\u1EAFt g\u1EB7p khu\xF4n m\u1EB7t xinh \u0111\u1EB9p
      c\u1EE7a ng\xE0i \u1EDF \u0111\xE2y! V\u1EC1 chuy\u1EC7n t\u1EA1i sao l\u1EA1i
      bi\u1EBFt th\xEC c\xF4 c\u1EE9 xem nh\u01B0 l\xE0 t\xECnh c\u1EDD nh\xE9."
  - speaker: Lilia
    text: "\xD4ng n\xF3i qu\xE1 r\u1ED3i, c\u1EA3m \u01A1n \xF4ng... Nh\u01B0ng hi\u1EC7n
      gi\u1EDD ta h\u01A1i g\u1EA5p, n\u1EBFu c\xF3 c\u01A1 h\u1ED9i ta s\u1EBD g\u1EB7p
      \xF4ng sau. Xin \xF4ng gi\u1EEF k\xEDn b\xED m\u1EADt t\xF4i \u0111ang \u1EDF
      \u0111\xE2y n\u1EBFu c\xF3 th\u1EC3."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Xin d\u1EEBng l\u1EA1i m\u1ED9t ch\xFAt, c\xF3 th\u1EC3 t\xF4i v\xF4 l\u1EC5,
      nh\u01B0ng xin \u0111\u01B0\u1EE3c ph\xE9p \u0111\u01B0\u1EE3c h\u1ECFi 1 c\xE2u.
      T\xF4i nghe th\u1EA5y m\xF9i m\xE1u t\u1EEB ng\xE0i, c\xF3 ph\u1EA3i t\xF4i
      nghe nh\u1EA7m kh\xF4ng? "
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: " V\xE0 c\xF3 chuy\u1EC7n g\xEC \u0111\xE3 x\u1EA3y ra v\u1EADy, t\xF4i
      c\u0169ng \u0111\xE3 nghe lo\xE1ng tho\xE1ng tin ho\xE0ng cung b\u1EA3o c\xF4ng
      ch\xFAa \u0111\xE3 b\u1ECF tr\u1ED1n kh\u1ECFi cung \u0111i\u1EC7n..."
  - speaker: Lilia
    text: ...
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Nh\xECn s\u1EAFc m\u1EB7t c\u1EE7a ng\xE0i t\xF4i xin cho r\u1EB1ng \u0111\xF3
      l\xE0 c\xE2u tr\u1EA3 l\u1EDDi r\u1ED3i. C\xF3 th\u1EC3 cho ph\xE9p t\xF4i
      \u0111\u01B0\u1EE3c nghe c\xE2u chuy\u1EC7n kh\xF4ng?"
  - speaker: "Ng\u01B0\u1EDDi d\u1EABn truy\u1EC7n"
    text: "Lilia k\u1EC3 cho K\u1EBB Bu\xF4n B\xE1n to\xE0n b\u1ED9 c\xE2u chuy\u1EC7n."
  - speaker: Lilia
    text: "Th\u1EBF \xF4ng c\xF3 bi\u1EBFt g\xEC v\u1EC1 chi\u1EBFc ch\xECa kh\xF3a
      n\xE0y kh\xF4ng?"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Chi\u1EBFc ch\xECa kh\xF3a n\xE0y l\xE0 1 trong 4 chi\u1EBFc \u0111\u1EC3
      m\u1EDF \u0111\u01B0\u1EE3c c\xE1nh c\u1EEDa si\xEAu l\u1EDBn trong L\xE2u
      \u0110\xE0i T\xECnh \xC1i, n\u01A1i Ma Z\u01B0\u01A1ng 2k Zeros tr\xFA ng\u1EE5. "
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Chi\u1EBFc ch\xECa n\xE0y \u0111\u01B0\u1EE3c giao cho 4 b\u1EC7 h\u1EA1
      c\u1EE7a h\u1EAFn, v\xE0 ng\xE0i Lilia \u0111\xE3 c\xF3 trong tay 1 sau khi
      \u0111\xE1nh b\u1EA1i \u0111\u01B0\u1EE3c Tay Tr\xE1i c\u1EE7a Ng\u1EE5c t\xF9
      V\u0129nh H\u1EB1ng"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: ...
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Nh\u01B0ng ng\xE0i s\u1EB5n s\xE0ng li\u1EC1u t\xEDnh m\u1EA1ng cho ho\xE0ng
      t\u1EED... th\u1EADt s\u1EF1 l\xE0 qu\xE1 anh d\u0169ng. T\xF4i ch\u1EC9 l\xE0
      m\u1ED9t \"K\u1EBB Bu\xF4n B\xE1n\", nh\u01B0ng t\xF4i s\u1EBD gi\xFAp ng\xE0i."
  - speaker: Lilia
    text: "B\u1EB1ng c\xE1ch n\xE0o...?"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "B\xE1n d\u1EE5ng c\u1EE5 ch\u1EC9 l\xE0 b\u1EC1 ngo\xE0i, t\xF4i th\u1EADt
      ra l\xE0 m\u1ED9t d\xE2n bu\xF4n v\u0169 kh\xED, h\xE0ng hi\u1EBFm l\xE0 \u0111\u1EB1ng
      kh\xE1c. "
  - speaker: "k\u1EBB Bu\xF4n B\xE1n"
    text: "T\xF4i mu\u1ED1n gi\xFAp \u0111\u1EE1 c\xF4ng ch\xFAa b\u1EB1ng c\xE1ch
      cung c\u1EA5p cho ng\xE0i nh\u1EEFng v\u0169 kh\xED m\u1EA1nh h\u01A1n \u0111\u1EC3
      chinh chi\u1EBFn s\u1EAFp t\u1EDBi."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Kh\xF4ng th\u1EC3 \u0111\u1ED3ng h\xE0nh c\xF9ng ng\xE0i nh\u01B0ng t\xF4i
      mong s\u1EBD gi\xFAp \u0111\u1EE1 \u0111\u01B0\u1EE3c ng\xE0i tr\xEAn h\xE0nh
      tr\xECnh nguy hi\u1EC3m n\xE0y, mong ng\xE0i s\u1EBD l\u1EA5y \u0111\u01B0\u1EE3c
      3 chi\u1EBFc ch\xECa kh\xF3a c\xF2n l\u1EA1i!!"
  - speaker: Lilia
    text: "Ch\xFAng... th\u1EADt s\u1EF1 l\xE0 h\xE0ng th\u1EADt. Nh\u01B0 th\u1EBF
      n\xE0y th\xEC \xF4ng c\xF3 th\u1EC3 b\u1ECB bu\u1ED9c t\u1ED9i chung th\xE2n
      \u0111\xF3."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: Haha...
  - speaker: Lilia
    text: "... Nh\u01B0ng \u0111\xFAng th\u1EADt l\xE0 n\u1EBFu kh\xF4ng c\xF3 v\u0169
      kh\xED t\u1ED1t h\u01A1n, t\xF4i kh\xF4ng th\u1EC3 chi\u1EBFn \u0111\u1EA5u
      l\xE2u d\xE0i..."
  - speaker: Lilia
    text: "... Ta th\u1EF1c s\u1EF1 r\u1EA5t bi\u1EBFt \u01A1n, khi m\u1ECDi chuy\u1EC7n
      ho\xE0n t\u1EA5t, ta ch\u1EAFc ch\u1EAFn s\u1EBD tr\u1EA3 \u01A1n cho \xF4ng..."
