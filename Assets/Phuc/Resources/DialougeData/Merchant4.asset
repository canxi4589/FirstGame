  m_Script: {fileID: 11500000, guid: e067866778c7d674684e5db79f8171b4, type: 3}
  m_Name: Merchant4
  m_EditorClassIdentifier: 
  dialogues:
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "V\u1EADy l\xE0 4 chi\u1EBFc ch\xECa kh\xF3a \u0111\xE3 n\u1EB1m tr\xEAn
      tay ng\xE0i, gi\u1EDD th\xEC L\xE2u \u0110\xE0i T\xECnh \xC1i s\u1EBD l\xE0
      n\u01A1i cu\u1ED1i c\xF9ng ng\xE0i ph\u1EA3i \u0111\u1EBFn."
  - speaker: Lilia
    text: ...
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Sao v\u1EADy, ng\xE0i Lilia?"
  - speaker: Lilia
    text: "Ta... c\xF3 v\u1EBB \u0111ang r\u1EA5t s\u1EE3. Ta s\u1EE3 r\u1EB1ng ta
      s\u1EBD kh\xF4ng th\u1EAFng n\u1ED5i Ma Z\u01B0\u01A1ng, ta s\u1EE3 r\u1EB1ng
      ta \u0111\xE3 qu\xE1 tr\u1EC5, ch\xE0ng c\xF3 l\u1EBD \u0111\xE3..."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Ng\xE0i Lilia! B\xECnh t\u0129nh n\xE0o!"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "H\u1EAFn c\u1EA7n ho\xE0ng t\u1EEB \u0111\u1EC3 ho\xE0n th\xE0nh k\u1EBF
      ho\u1EA1ch h\u1EE7y di\u1EC7t x\u1EE9 s\u1EDF Tinh T\xFA, n\xEAn t\xF4i c\xF3
      th\u1EC3 d\xE1m ch\u1EAFc ng\xE0i \u1EA5y c\xF2n s\u1ED1ng."
  - speaker: Lilia
    text: ...
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Ng\xE0i \u0111\xE3 \u0111i xa \u0111\u1EBFn \u0111\xE2y r\u1ED3i, t\xF4i
      tin ng\xE0i \u0111\xE3 m\u1EA1nh m\u1EBD h\u01A1n, v\u1EC1 m\u1ECDi th\u1EE9.
      T\xF4i tin r\u1EB1ng ng\xE0i s\u1EBD c\u1EE9u \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi
      m\xECnh y\xEAu."
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "\u0110\xE2y c\xF3 th\u1EC3 l\xE0 l\u1EA7n cu\u1ED1i c\xF9ng t\xF4i \u0111\u01B0\u1EE3c
      g\u1EB7p n\xE0ng, t\xF4i s\u1EBD gi\xE0nh m\u1ECDi l\u1EDDi c\u1EA7u nguy\u1EC7n
      t\u1ED1t nh\u1EA5t, mong ng\xE0i chi\u1EBFn th\u1EAFng tr\u1EDF v\u1EC1."
  - speaker: Lilia
    text: "M\u1ED9t l\u1EA7n n\u1EEFa, ta ch\xE2n th\xE0nh c\u1EA3m \u01A1n."
  - speaker: Lilia
    text: "Ta v\u1EABn kh\xF4ng tin \u0111\u01B0\u1EE3c nh\u1EEFng \u0111i\u1EC1u
      n\xE0y x\u1EA3y ra, m\u1ECDi th\u1EE9 th\u1EADt s\u1EF1 r\u1EA5t v\xF4 l\xED,
      nh\u01B0ng hi\u1EC7n th\u1EF1c l\xE0 \u0111\xE2y, ta s\u1EBD th\u1EAFng v\xE0
      c\u1EE9u ch\xE0ng."
  - speaker: Lilia
    text: "H\xE3y ch\u1EDD tin t\u1ED1t nh\xE9"
  - speaker: "K\u1EBB Bu\xF4n B\xE1n"
    text: "Ch\u1EAFc ch\u1EAFn r\u1ED3i, th\u01B0a ng\xE0i Lilia."
